rules_version = '2';

// Public: browse cars, read dealership settings, submit an inquiry (lead).
// Staff (admin / manager / operator): manage cars and leads.
// New sign-ups start as "pending" and can do nothing until an admin promotes them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return get(profilePath()).data.role;
    }

    function isStaff() {
      return signedIn() && exists(profilePath()) && role() in ['admin', 'manager', 'operator'];
    }

    function isAdmin() {
      return isStaff() && role() == 'admin';
    }

    match /cars/{carId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'phone', 'message', 'carId', 'carLabel', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 50
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.carLabel is string
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is number;
      allow read, update, delete: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // Self-registration only ever creates a pending profile.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
                    && request.resource.data.role == 'pending';
      // Admins can change roles, nothing else about a profile.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() && role() in ['admin', 'manager'];
    }
  }
}
